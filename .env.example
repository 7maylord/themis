# Network
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=
SEPOLIA_CHAIN_ID=11155111

# Deployer — a disposable Sepolia-only testnet key, funded from a faucet.
# Never reuse this key for anything holding real value.
PRIVATE_KEY=

# Flashbots (Task 9/10 — protected routing and controlled searcher bundle)
FLASHBOTS_PROTECT_RPC=https://rpc-sepolia.flashbots.net/
FLASHBOTS_RELAY_URL=https://relay-sepolia.flashbots.net
FLASHBOTS_AUTH_PRIVATE_KEY=

# Contracts (set after 00_DeployThemis.s.sol runs)
THEMIS_HOOK_ADDRESS=
FAIR_SHARE_VAULT_ADDRESS=

# Pool (currency0 is native ETH — no TOKEN0_ADDRESS)
TOKEN1_ADDRESS=
POOL_ID=

# App
#
# NOTE: this root .env is read by the Foundry scripts only. Next.js (frontend/)
# only reads .env files inside frontend/ itself — copy any NEXT_PUBLIC_* vars
# you set here into frontend/.env.local too, or they silently never reach the
# browser. (Missing NEXT_PUBLIC_PRIVY_APP_ID there specifically renders the
# "Connect Wallet" button disabled, not broken-but-clickable.)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_CHAIN_ID=11155111

# Privy (wallet connect UI) — create an app at https://dashboard.privy.io and
# paste its App ID here (and in frontend/.env.local — see note above).
NEXT_PUBLIC_PRIVY_APP_ID=
